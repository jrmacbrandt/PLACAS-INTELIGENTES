# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INTEGRAÇÃO DE PAGAMENTOS (ASAAS)
# Obtenha em: Minha Conta -> Integrações -> Chaves de API no painel do Asaas.
# Basta preencher estas variáveis para ativar a comunicação real de produção/sandbox.
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_ENVIRONMENT="sandbox" # ou "production"

# INTEGRAÇÃO DE FRETE (MELHOR ENVIO)
# Obtenha seu Bearer Token em: Painel Melhor Envio -> Gerenciar -> Tokens / Chaves de API
# O sistema calcula automaticamente com descontos corporativos de até 80% (Jadlog, Correios, Loggi)
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_ENV="sandbox" # "sandbox" (sandbox.melhorcomunicacao.com.br) ou "production" (melhorenvio.com.br)
ATELIER_ORIGIN_CEP="22745271" # Jacarepaguá, Rio de Janeiro - RJ (Atelier das Placas)

# BANCO DE DADOS EM NUVEM E STORAGE (SUPABASE)
# Obtenha em: Painel Supabase -> Project Settings -> API
# Região recomendada ao criar o projeto: South America / sa-east-1 (São Paulo, Brasil) para latência < 100ms no QR Code
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


