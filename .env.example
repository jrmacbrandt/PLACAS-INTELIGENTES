# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INTEGRAÇÃO DE PAGAMENTOS (ASAAS)
# Obtenha em: Minha Conta -> Integrações -> Chaves de API no painel do Asaas.
# Basta preencher estas variáveis para ativar a comunicação real de produção/sandbox.
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_ENVIRONMENT="sandbox" # ou "production"

# INTEGRAÇÃO OFICIAL DE FRETE E ETIQUETAS (MELHOR ENVIO V2)
# Desenvolva e teste primeiro em Sandbox:
#   Cadastro Sandbox: https://sandbox.melhorenvio.com.br
#   Área Dev / Criar App: https://app-sandbox.melhorenvio.com.br/integracoes/area-dev
# Produção:
#   Base: https://melhorenvio.com.br
#   Área Dev: https://app.melhorenvio.com.br/integracoes/area-dev
MELHOR_ENVIO_ENV="sandbox" # "sandbox" ou "production" (ambientes totalmente isolados)
MELHOR_ENVIO_CLIENT_ID="" # ID numérico do aplicativo cadastrado na Área Dev
MELHOR_ENVIO_CLIENT_SECRET="" # Segredo do aplicativo cadastrado na Área Dev
MELHOR_ENVIO_REDIRECT_URI="https://placasinteligentes.vercel.app/api/integrations?action=melhor-envio-oauth-callback"
MELHOR_ENVIO_WEBHOOK_SECRET="" # Segredo configurado para validação HMAC-SHA256 (X-ME-Signature)
MELHOR_ENVIO_TOKEN="" # Token Bearer oficial (ou gerado via OAuth2 Authorization Code)
MELHOR_ENVIO_REFRESH_TOKEN="" # Token de renovação automática (validade de 45 dias)
MELHOR_ENVIO_USER_AGENT="AtelierDasPlacas (suporte@atelierdasplacas.com.br)"
ATELIER_ORIGIN_CEP="22745271" # Jacarepaguá, Rio de Janeiro - RJ (Atelier das Placas)

# BANCO DE DADOS EM NUVEM E STORAGE (SUPABASE)
# Obtenha em: Painel Supabase -> Project Settings -> API
# Região recomendada ao criar o projeto: South America / sa-east-1 (São Paulo, Brasil) para latência < 100ms no QR Code
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
