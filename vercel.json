{
  "crons": [
    {
      "path": "/api/cron/cleanup-qrcodes",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/scheduled-backup",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/r?token=:token"
    },
    {
      "source": "/((?!api/|r/).*)",
      "destination": "/index.html"
    }
  ]
}
